{
  "name": "Vinterkort",
  "short_name": "Vinterkort",
  "description": "See where you are on your salting work-order maps.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14232e",
  "theme_color": "#14232e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf"] }] }
  }
}
